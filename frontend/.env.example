# Optional: override the demo account values in frontend/.env.local or your build environment.
# The default demo values are admin@admin.com / 123456 and user@user.com / 123456.
# Frontend credentials are public in the built JavaScript; use only on a demo database.
REACT_APP_DEMO_ADMIN_EMAIL=admin@admin.com
REACT_APP_DEMO_ADMIN_PASSWORD=123456
REACT_APP_DEMO_USER_EMAIL=user@user.com
REACT_APP_DEMO_USER_PASSWORD=123456

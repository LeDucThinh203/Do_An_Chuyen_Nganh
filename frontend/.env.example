# Copy to frontend/.env.local and set credentials for an isolated demo/test database.
# The buttons appear on the home and login pages when enabled and both account pairs are set.
# Credentials are embedded in the frontend bundle at build time; never use production accounts.
# Restart `npm start` after editing, or set these values in the frontend build environment before deployment.
REACT_APP_ENABLE_DEMO_LOGIN=false
REACT_APP_DEMO_ADMIN_EMAIL=
REACT_APP_DEMO_ADMIN_PASSWORD=
REACT_APP_DEMO_USER_EMAIL=
REACT_APP_DEMO_USER_PASSWORD=

# Database Configuration
# Optional Neon PostgreSQL connection string. Use the pooled URL copied from Neon
# (the hostname includes -pooler and the URL includes sslmode=require).
DATABASE_URL=

# Used by the local PostgreSQL service in docker-compose.yml
POSTGRES_DB=DBWebBanDoBongDa
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me-locally

# Backend pool settings (each backend process can open up to DB_POOL_MAX clients)
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONN_TIMEOUT_MS=15000

# Backend Configuration
JWT_SECRET=your-secret-key-here-change-in-production
GEMINI_API_KEY=your-gemini-api-key-here

# Port Configuration
BACKEND_PORT=3006
FRONTEND_PORT=80
